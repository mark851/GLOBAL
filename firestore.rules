rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'markniaras@gmail.com' ||
        request.auth.token.email == 'maserekasandra66@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Products collection: public can read, store admins and manager can write
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    // Categories collection: store taxonomy
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if true;
    }

    // Orders collection: customers place orders, admins manage status
    match /orders/{orderId} {
      allow read: if true;
      allow write: if true;
    }

    // Payments collection: tracking transactions
    match /payments/{paymentId} {
      allow read: if true;
      allow write: if true;
    }

    // Inventory movements
    match /inventoryMovements/{movementId} {
      allow read, write: if true;
    }

    // Coupons
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if true;
    }

    // Reviews
    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if true;
    }

    // Settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // Admins collection
    match /admins/{adminId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
