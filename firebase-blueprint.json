{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Wellness product in the Go Global Edge store",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "subtitle": { "type": "string", "maxLength": 150 },
        "description": { "type": "string", "maxLength": 2000 },
        "price": { "type": "number" },
        "salePrice": { "type": "number" },
        "stock": { "type": "number" },
        "sku": { "type": "string", "maxLength": 50 },
        "category": { "type": "string", "maxLength": 50 },
        "images": { "type": "array" },
        "featured": { "type": "boolean" },
        "status": { "type": "string", "enum": ["published", "draft", "archived"] },
        "directions": { "type": "string", "maxLength": 1000 },
        "ingredients": { "type": "string", "maxLength": 1000 },
        "packageInfo": { "type": "string", "maxLength": 200 },
        "manufacturer": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "price", "stock", "category", "status"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase order",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderNumber": { "type": "string", "maxLength": 50 },
        "customerId": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 100 },
        "customerEmail": { "type": "string", "maxLength": 100 },
        "customerPhone": { "type": "string", "maxLength": 50 },
        "deliveryAddress": { "type": "string", "maxLength": 300 },
        "district": { "type": "string", "maxLength": 100 },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "deliveryFee": { "type": "number" },
        "discount": { "type": "number" },
        "totalAmount": { "type": "number" },
        "currency": { "type": "string", "maxLength": 10 },
        "paymentMethod": { "type": "string", "enum": ["mtn_mobile_money", "airtel_money", "bank_card", "cash_on_delivery"] },
        "paymentStatus": { "type": "string", "enum": ["Pending", "Successful", "Failed", "Cancelled", "Refund Pending", "Refunded"] },
        "orderStatus": { "type": "string", "enum": ["Pending", "Awaiting Payment", "Paid", "Processing", "Ready for Dispatch", "Shipped", "Delivered", "Cancelled", "Refunded"] },
        "transactionRef": { "type": "string", "maxLength": 100 },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "orderNumber", "customerName", "customerPhone", "deliveryAddress", "district", "items", "totalAmount", "paymentMethod", "orderStatus"]
    },
    "Payment": {
      "title": "Payment",
      "description": "Payment transaction record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "transactionRef": { "type": "string", "maxLength": 100 },
        "orderId": { "type": "string", "maxLength": 128 },
        "orderNumber": { "type": "string", "maxLength": 50 },
        "customerName": { "type": "string", "maxLength": 100 },
        "customerPhone": { "type": "string", "maxLength": 50 },
        "amount": { "type": "number" },
        "currency": { "type": "string", "maxLength": 10 },
        "method": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "maxLength": 50 },
        "provider": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "transactionRef", "orderNumber", "amount", "method", "status"]
    },
    "InventoryMovement": {
      "title": "InventoryMovement",
      "description": "Stock audit and movement log",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "productId": { "type": "string", "maxLength": 128 },
        "productName": { "type": "string", "maxLength": 100 },
        "type": { "type": "string", "enum": ["restock", "sale", "adjustment", "damaged"] },
        "quantity": { "type": "number" },
        "previousStock": { "type": "number" },
        "newStock": { "type": "number" },
        "reason": { "type": "string", "maxLength": 200 },
        "createdBy": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "productId", "type", "quantity", "previousStock", "newStock"]
    },
    "Coupon": {
      "title": "Coupon",
      "description": "Discount promo codes",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string", "maxLength": 50 },
        "discountType": { "type": "string", "enum": ["percent", "fixed"] },
        "discountValue": { "type": "number" },
        "minOrderAmount": { "type": "number" },
        "maxUses": { "type": "number" },
        "usedCount": { "type": "number" },
        "isActive": { "type": "boolean" },
        "expiresAt": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "code", "discountType", "discountValue", "isActive"]
    },
    "Review": {
      "title": "Review",
      "description": "Customer product reviews",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "productId": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 100 },
        "customerEmail": { "type": "string", "maxLength": 100 },
        "rating": { "type": "number" },
        "title": { "type": "string", "maxLength": 150 },
        "comment": { "type": "string", "maxLength": 1000 },
        "verifiedPurchase": { "type": "boolean" },
        "status": { "type": "string", "enum": ["approved", "pending", "rejected"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "productId", "customerName", "rating", "comment", "status"]
    },
    "Setting": {
      "title": "Setting",
      "description": "Store configuration and delivery rules",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "businessName": { "type": "string", "maxLength": 100 },
        "contactEmail": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 50 },
        "whatsapp": { "type": "string", "maxLength": 50 },
        "currency": { "type": "string", "maxLength": 10 },
        "deliveryKampala": { "type": "number" },
        "deliveryWakiso": { "type": "number" },
        "deliveryUpcountry": { "type": "number" },
        "freeDeliveryThreshold": { "type": "number" },
        "heroTitle": { "type": "string", "maxLength": 150 },
        "heroSubtitle": { "type": "string", "maxLength": 250 },
        "announcement": { "type": "string", "maxLength": 200 }
      },
      "required": ["id", "businessName", "currency"]
    },
    "Category": {
      "title": "Category",
      "description": "Store product classification and taxonomy",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 500 },
        "slug": { "type": "string", "maxLength": 100 }
      },
      "required": ["id", "name", "slug"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Store products available for purchase"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Orders submitted by customers"
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Store product categories and taxonomies"
    },
    "/payments/{paymentId}": {
      "schema": "Payment",
      "description": "Payment records and status tracking"
    },
    "/inventoryMovements/{movementId}": {
      "schema": "InventoryMovement",
      "description": "Audit trail for product stock changes"
    },
    "/coupons/{couponId}": {
      "schema": "Coupon",
      "description": "Discount voucher codes"
    },
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Product customer feedback"
    },
    "/settings/{settingId}": {
      "schema": "Setting",
      "description": "Store configuration and delivery rules"
    }
  }
}
